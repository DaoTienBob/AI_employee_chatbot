# Copy this file to `.env` and adjust values for your machine.
# Never commit the real .env file.

# --- Application ---
APP_DEBUG=true

# --- Sessions / security (FR01) ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Storage ---
# DATABASE_URL=sqlite:///./data/app.db
# CHROMA_DIR=./data/chroma
# UPLOAD_DIR=./data/uploads

# --- Document ingestion (FR02) ---
MAX_UPLOAD_SIZE_MB=20

# --- Chunking (T06) ---
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# --- Embeddings: sentence_transformers | ollama | minilm ---
# Independent of LLM_PROVIDER / LLM_MODEL. Restart and reindex after changes.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_QUERY_PREFIX=""
EMBEDDING_DOCUMENT_PREFIX=""
EMBEDDING_DEVICE=cpu
# EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_TIMEOUT_SECONDS=120
# E5 alternative: provider=sentence_transformers, model=intfloat/multilingual-e5-base
# with query prefix="query: " and document prefix="passage: ".
# Pull the Ollama model first; uses OLLAMA_BASE_URL below.

# --- Retrieval (T10) ---
RETRIEVAL_TOP_K=5

# --- Logging (file output for RAG/doc retrieval) ---
# LOG_DIR=./data/logs
# LOG_FILE=rag.log
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=3

# --- LLM (FR04, T13): ollama | openai ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- CORS (React dev servers) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Query rewriting (uses LLM_PROVIDER; blank model uses LLM_MODEL) ---
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=qwen3.5:latest
QUERY_REWRITE_TIMEOUT_SECONDS=15
