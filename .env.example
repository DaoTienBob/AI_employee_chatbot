# ============================================================================
# AI Employee Knowledge Assistant — environment configuration
#
#   cp .env.example .env     # then edit values for your machine
#
# - .env is gitignored: put real API keys ONLY in .env, never in this file.
# - The backend reads this file once at startup — RESTART after any change.
# - Commented-out variables fall back to the code defaults shown; uncomment
#   only what you need to override.
# ============================================================================

# --- 1. Application & auth ---------------------------------------------------
# APP_DEBUG=true enables dev conveniences: demo users, verbose errors.
APP_DEBUG=true

# Signs session JWTs. Use a long random string in real deployments.
SECRET_KEY=change-me-to-a-long-random-string

# Session lifetime for login tokens (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- 2. Storage (optional overrides; defaults live under ./data/) -----------
# DATABASE_URL=sqlite:///./data/app.db     # SQLite file
# CHROMA_DIR=./data/chroma                 # ChromaDB vector index
# UPLOAD_DIR=./data/uploads                # uploaded source documents

# --- 3. Ingestion, chunking & retrieval --------------------------------------
# Hard cap for document uploads (MB).
MAX_UPLOAD_SIZE_MB=20

# Token-aware chunking: chunk length and overlap (tokens).
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# How many document chunks each search retrieves per query variant.
RETRIEVAL_TOP_K=5

# Maximum cosine distance for a chunk to count as evidence; farther chunks
# trigger the safe "no information" fallback. Cosine scores are NOT
# comparable across embedding models — recalibrate per model.
# FALLBACK_DISTANCE_THRESHOLD=0.7

# --- 4. Embeddings ------------------------------------------------------------
# Vectorizes documents and questions. INDEPENDENT of the answer LLM below.
# Providers: ollama | sentence_transformers | minilm
# Changing provider/model invalidates the index: restart, then re-upload docs.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_DEVICE=cpu
EMBEDDING_TIMEOUT_SECONDS=120
# EMBEDDING_CACHE_DIR=./data/models       # only for sentence_transformers
#
# E5 alternative:
#   EMBEDDING_PROVIDER=sentence_transformers
#   EMBEDDING_MODEL=intfloat/multilingual-e5-base
#   EMBEDDING_QUERY_PREFIX="query: "  EMBEDDING_DOCUMENT_PREFIX="passage: "

# --- 5. Answer LLM ------------------------------------------------------------
# Generates the grounded answer. Providers: ollama | openai | gemini | mock
#
# Profile A — local Ollama (default):
#   LLM_PROVIDER=ollama, LLM_MODEL=qwen3.5:latest, keep OLLAMA_BASE_URL below.
#   Pull the model first: `ollama pull qwen3.5:latest`
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# Profile B — Gemini (fast, no local model load):
#   LLM_PROVIDER=gemini, LLM_MODEL=gemini-3.6-flash  (gemini-2.5-flash
#   returns HTTP 404 for new users), and set GEMINI_API_KEY here.
# Profile C — any OpenAI-compatible API (OpenAI, Groq, Mistral, ...):
#   LLM_PROVIDER=openai, set OPENAI_API_KEY, optionally OPENAI_BASE_URL.
#
# Keys go ONLY in the gitignored .env — never commit them.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- 6. Query rewriting -------------------------------------------------------
# Optional pre-retrieval step: restores Vietnamese accents and makes follow-up
# questions standalone. See README "Query rewriting" before changing.
QUERY_REWRITE_ENABLED=true

# always | adaptive | off. adaptive = local phrase rules decide per question.
QUERY_REWRITE_MODE=adaptive

# inherit = use LLM_PROVIDER/LLM_MODEL from section 5 (recommended: both
# stages share one loaded model instead of two). Alternatives: ollama |
# openai | gemini | mock — then also set QUERY_REWRITE_MODEL and its API key.
QUERY_REWRITE_PROVIDER=inherit
# Empty model = reuse LLM_MODEL from section 5.
QUERY_REWRITE_MODEL=
# Generous timeout: covers local model loading. Fallback uses the original query.
QUERY_REWRITE_TIMEOUT_SECONDS=60

# --- 7. Logging (optional; file output for the RAG pipeline) -------------------
# LOG_DIR=./data/logs
# LOG_FILE=rag.log
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=3

# --- 8. CORS -------------------------------------------------------------------
# Origins allowed to call the API. The Vite dev server (5173) is proxied by
# vite.config.js, so CORS mostly matters for other clients (e.g. :3000).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- 9. Startup behaviour -------------------------------------------------------
# Verify vector-index permissions against SQLite at startup; blocks startup
# on drift. Set to false only for repairs.
# VERIFY_INDEX_ON_STARTUP=true
# Evict Ollama models from RAM on backend shutdown.
# UNLOAD_OLLAMA_ON_SHUTDOWN=true

